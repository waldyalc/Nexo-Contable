# Supabase (proyecto Nexo Contable — cuenta dedicada)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo para scripts locales de migración / administración (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Token personal de Supabase CLI SOLO para este proyecto (no afecta tu cuenta global del PC)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=TU-PROJECT-REF

# URL base de la aplicación (OAuth callback Google)
NEXT_PUBLIC_APP_URL=http://localhost:3000
